        end

        CONN --> EXEC
        EXEC --> AuthFns
        EXEC --> UserFns
        EXEC --> ProfileFns
        EXEC --> FeedFns
        EXEC --> SocialFns
        EXEC --> CommFns
        EXEC --> EventFns
        EXEC --> MiscFns
    end

    subgraph Storage["Storage"]
        SQLITE["SQLite\nnexus.db (local dev)"]
        PG["PostgreSQL\n(Render production\nDATABASE_URL env var)"]
    end

    CONN -->|"_USE_PG = False"| SQLITE
    CONN -->|"_USE_PG = True"| PG
